<% flat_pack_page_nav(
     round: true,
     style: :default,
     back_tooltip: t("recording_studio.web_search.runs.searches", default: "Searches"),
     anchor_href: page_nav_anchor_url(default: RecordingStudioAdmin.configuration.surface_for(:admin).path)
   ) %>
<% recording_studio_page_nav_right do %>
  <%= render FlatPack::Button::Component.new(text: t("recording_studio.web_search.runs.searches", default: "Searches"), href: @back_url, style: :secondary) %>
<% end %>

<%= render FlatPack::PageTitle::Component.new(title: @run.query.to_s, subtitle: @subtitle.presence) %>

<%= render FlatPack::Stack::Component.new(gap: :lg) do %>
  <%= render FlatPack::Badge::Component.new(
    text: @run.outcome,
    style: (@run.status == "succeeded" ? :success : :danger),
    size: :sm
  ) %>

  <% if @pages.empty? %>
    <%= render FlatPack::Alert::Component.new(style: :info, description: @empty_message) %>
  <% else %>
    <%= render FlatPack::List::Component.new(divider: true) do %>
      <% @pages.each do |page| %>
        <%= render FlatPack::List::Item.new(**result_item_options(page)) do %>
          <%= render FlatPack::Text::Component.new(text: page["title"].to_s, as: :div, weight: :semibold) %>
          <% if page["domain"].present? %>
            <%= render FlatPack::Text::Component.new(text: page["domain"].to_s, as: :div, size: :sm, style: :muted) %>
          <% end %>
          <% if page["description"].present? %>
            <%= render FlatPack::Text::Component.new(text: page["description"].to_s, as: :p, size: :sm, class: "mt-1 leading-6") %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
