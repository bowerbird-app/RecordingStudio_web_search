<%# The default layout strips these slots, then PageTitle escapes them. Store raw characters. %>
<% content_for :title, @run.query.to_s.html_safe %>
<% content_for :subtitle, @subtitle.to_s.html_safe %>
<% flat_pack_page_nav(
     round: true,
     style: :default,
     back_tooltip: t("recording_studio.web_search.runs.searches", default: "Searches"),
     anchor_href: page_nav_anchor_url(default: RecordingStudioAdmin.configuration.default_mount_path)
   ) %>
<% recording_studio_page_nav_right do %>
  <%= render FlatPack::Button::Component.new(text: t("recording_studio.web_search.runs.searches", default: "Searches"), href: @back_url, style: :secondary) %>
<% end %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::Badge::Component.new(
    text: @run.outcome,
    style: (@run.status == "succeeded" ? :success : :danger),
    size: :sm
  ) %>

  <% if @pages.empty? %>
    <%= render FlatPack::Alert::Component.new(style: :info, description: @empty_message) %>
  <% else %>
    <%= render FlatPack::List::Component.new(divider: true) do %>
      <% @pages.each do |page| %>
        <%= render FlatPack::List::Item.new(**result_item_options(page)) do %>
          <span class="block font-semibold"><%= page["title"] %></span>
          <% if page["domain"].present? %>
            <span class="block text-sm text-(--surface-muted-content-color)"><%= page["domain"] %></span>
          <% end %>
          <% if page["description"].present? %>
            <span class="mt-1 block text-sm leading-6"><%= page["description"] %></span>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
