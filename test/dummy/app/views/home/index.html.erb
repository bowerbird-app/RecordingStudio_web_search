<% dummy_page_nav(title: "Web search", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Web search",
    subtitle: "Type a question. We'll fetch public pages.",
    variant: :h1
  ) %>

  <%= form_with url: root_path, method: :get do %>
    <div class="flex flex-col gap-4">
      <%= render FlatPack::SearchInput::Component.new(
        name: "q",
        label: "Query",
        value: params[:q]
      ) %>
      <%= render FlatPack::Button::Component.new(
        text: "Search",
        style: :primary,
        type: :submit
      ) %>
    </div>
  <% end %>

  <% if @error %>
    <%= render FlatPack::Alert::Component.new(
      style: :danger,
      description: @error.message
    ) %>
  <% end %>

  <% if @response %>
    <% if @response.results.empty? %>
      <%= render FlatPack::Alert::Component.new(
        style: :info,
        description: "Nothing turned up. Try a different query."
      ) %>
    <% else %>
      <% @response.results.each do |result| %>
        <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
          <% card.body do %>
            <p class="font-semibold"><%= link_to result.title, result.url %></p>
            <p class="text-sm text-(--surface-muted-content-color)"><%= result.domain %></p>
            <% if result.description.present? %>
              <p class="text-sm leading-6"><%= result.description %></p>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</div>
