<%= render FlatPack::PageTitle::Component.new(title: "Admin", subtitle: "Staff tools for this site.") %>
<% flat_pack_page_nav(round: true, style: :default, back_href: main_app.root_path, back_tooltip: "Home") %>

<% if @admin_sections.any? %>
  <%= render FlatPack::List::Component.new(divider: true) do %>
    <% @admin_sections.each do |section| %>
      <%= render FlatPack::List::Item.new(href: admin_section_href(section.url), hover: true) do %>
        <span><%= section.title %></span>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <p class="text-sm text-(--surface-muted-content-color)">Nothing to manage yet.</p>
<% end %>
